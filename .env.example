# URL de conexão com o banco de dados PostgreSQL, usada pela aplicação em tempo de execução.
# Exemplo local: postgresql://usuario:senha@localhost:5432/lithos
# Exemplo Neon (recomendado): use a connection string "pooled" (com "-pooler" no host).
DATABASE_URL="postgresql://usuario:senha@localhost:5432/lithos"

# URL de conexão direta (sem pooler), usada apenas para rodar migrations.
# Em provedores sem pooler (Postgres local, por exemplo) pode ser igual à DATABASE_URL.
DIRECT_URL="postgresql://usuario:senha@localhost:5432/lithos"

# Chave secreta usada pelo Auth.js para assinar sessões e tokens.
# Gere uma chave segura com: npx auth secret   (ou: openssl rand -base64 32)
AUTH_SECRET="defina-uma-chave-secreta-aleatoria-aqui"

# URL pública onde a aplicação está rodando (necessário em produção).
AUTH_URL="http://localhost:3000"

# Token secreto usado pela rota de keep-alive do banco de dados (ver seção "Manter o banco ativo" do README).
# Gere um valor aleatório qualquer, ex.: openssl rand -hex 24
CRON_SECRET="defina-um-token-aleatorio-aqui"
